function RoleCard({ icon, title, text, points, ctaLabel, ctaTo, note, featured = false }) {
  return (
    <div className={`role-card ${featured ? 'is-featured' : ''}`}>
      <div className="role-icon">{icon}</div>
      <h3>{title}</h3>
      <p>{text}</p>
      <ul className="role-points">
        {points.map((p) => (
          <li key={p}><Check size={14} strokeWidth={3} /> <span>{p}</span></li>
        ))}
      </ul>
      <div className="role-cta-wrap">
        <Link to={ctaTo} className={`btn btn-block ${featured ? '' : 'btn-secondary'}`}>
          {ctaLabel} <ArrowRight size={16} />
        </Link>
        {note && <p className="role-note">{note}</p>}
      </div>
    </div>
  )
}

function FeatureCard({ icon, title, text }) {
  const handleMouseMove = (e) => {
    const rect = e.currentTarget.getBoundingClientRect()
    const x = ((e.clientX - rect.left) / rect.width) * 100
    const y = ((e.clientY - rect.top) / rect.height) * 100
    e.currentTarget.style.setProperty('--mx', `${x}%`)
    e.currentTarget.style.setProperty('--my', `${y}%`)
  }

  return (
    <div className="feature-card" onMouseMove={handleMouseMove}>
      <div className="feature-icon">{icon}</div>
      <h3>{title}</h3>
      <p>{text}</p>
    </div>
  )
}

function Step({ n, title, text }) {
  return (
    <div className="step">
      <div className="step-number">{n}</div>
      <h3>{title}</h3>
      <p>{text}</p>
    </div>
  )
}
